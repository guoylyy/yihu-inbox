<%- include('layout/head') %>
<main class="yh-app yh-app--wide" id="home">
  <div class="yh-page-head head-bar">
    <div>
      <h1>我的待办</h1>
      <p class="yh-sub">一句话记下来，今天该做的、谁在做，一屏看清。</p>
    </div>
    <% if (!problem) { %>
      <div class="head-actions">
        <button class="yh-btn yh-btn--text head-idle" id="select-btn" type="button">选择</button>
        <a class="yh-btn yh-btn--text head-idle" id="import-btn" href="import">导入</a>
        <details class="pop" id="select-all">
          <summary class="yh-btn yh-btn--text">全选 <span class="caret" aria-hidden="true">›</span></summary>
          <div class="pop-list">
            <button id="batch-screen" type="button">全选本屏</button>
            <button id="batch-all" type="button">全部选中</button>
          </div>
        </details>
      </div>
    <% } %>
  </div>

  <% if (problem) { %>
    <div class="yh-error">
      <p class="empty"><%= problem %></p>
      <button class="yh-btn yh-btn--ghost" type="button" data-reload>重试</button>
    </div>
  <% } else { %>
    <div class="split split--rail">
      <section>
        <nav class="tabs" aria-label="视图">
          <% for (const [key, label] of tabs) { %>
            <a class="tab<%= key === view ? ' on' : '' %>" href="?view=<%= key %>" data-view="<%= key %>"<%- key === view ? ' aria-current="page"' : '' %>><%= label %></a>
          <% } %>
        </nav>
        <form class="quick" id="quick" autocomplete="off">
          <input class="yh-input" id="quick-input" name="text" type="text" maxlength="<%= inputMax %>" placeholder="一句话记下要做的事" aria-label="一句话记下要做的事" enterkeyhint="done">
          <button class="yh-btn" id="quick-btn" type="submit">记下</button>
        </form>
        <section id="list" data-view="<%= view %>"><%- include('partials/list') %></section>
      </section>
      <aside class="side" id="rail" aria-label="今日概览"><%- include('partials/rail') %></aside>
    </div>
  <% } %>
</main>

<% if (!problem) { %>
  <div class="batch-bar" id="batch-bar" role="toolbar" aria-label="批量操作" hidden>
    <div class="batch-top">
      <span class="batch-count" id="batch-count">已选 0 条</span>
      <button class="yh-btn yh-btn--text" id="batch-cancel" type="button">取消</button>
    </div>
    <div class="batch-actions" id="batch-actions">
      <button class="yh-btn yh-btn--ghost" data-batch="reschedule" type="button">改期</button>
      <button class="yh-btn yh-btn--ghost" data-batch="assign" type="button">指派</button>
      <button class="yh-btn yh-btn--ghost" data-batch="done" type="button">完成</button>
      <button class="yh-btn yh-btn--ghost" data-batch="more" type="button">更多 <span class="caret" aria-hidden="true">›</span></button>
    </div>
    <div class="batch-actions batch-actions--one" id="batch-restore" hidden>
      <button class="yh-btn yh-btn--ghost" data-batch="restore" type="button">恢复</button>
    </div>
  </div>

  <dialog class="yh-sheet yh-sheet--auto" id="reschedule" aria-labelledby="reschedule-title">
    <div class="yh-sheet-box">
      <header class="yh-sheet-head">
        <h2 id="reschedule-title">改期</h2>
        <button class="yh-btn yh-btn--text" type="button" data-close aria-label="关闭">×</button>
      </header>
      <div class="yh-sheet-body">
        <div class="presets">
          <button class="yh-btn yh-btn--ghost" type="button" data-preset="today">今天</button>
          <button class="yh-btn yh-btn--ghost" type="button" data-preset="tomorrow">明天</button>
          <button class="yh-btn yh-btn--ghost" type="button" data-preset="next_week">下周一</button>
        </div>
        <label class="yh-field custom-due"><span class="yh-label">自定义日期</span>
          <input id="custom-due" type="date">
        </label>
      </div>
      <footer class="yh-sheet-foot">
        <button class="yh-btn" id="custom-due-ok" type="button">改到这天</button>
      </footer>
    </div>
  </dialog>

  <dialog class="yh-sheet yh-sheet--auto" id="more-sheet" aria-labelledby="more-title">
    <div class="yh-sheet-box">
      <header class="yh-sheet-head">
        <h2 id="more-title">更多操作</h2>
        <button class="yh-btn yh-btn--text" type="button" data-close aria-label="关闭">×</button>
      </header>
      <div class="yh-sheet-body more-list">
        <button class="more-item" data-batch="archive" type="button"><span>归档</span><span class="yh-hint">从列表和统计里移除，可在「已完成 → 已归档」找回</span></button>
        <button class="more-item more-item--danger" data-batch="delete" type="button"><span>删除</span></button>
      </div>
    </div>
  </dialog>

  <%- include('partials/form') %>
  <%- include('partials/picker') %>
<% } %>
<%- include('layout/foot') %>
