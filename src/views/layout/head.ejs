<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<base href="<%= base %>">
<title>收件箱</title>
<link rel="icon" type="image/svg+xml" href="static/icon.svg?v=<%= version %>">
<link rel="stylesheet" href="static/yh-vi.css?v=<%= version %>">
<link rel="stylesheet" href="static/app.css?v=<%= version %>">
<script src="static/app.js?v=<%= version %>" defer></script>
<% for (const s of scripts) { %><script src="static/<%= s %>.js?v=<%= version %>" defer></script>
<% } %></head>
<body>
<header class="yh-top">
  <a class="yh-top-brand" href="./">
    <svg class="yh-top-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9.5 17h5l1.5-3H18a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2h2Z"/>
      <path d="M6.37 13.08L7 5.95A2 2 0 0 1 9.16 4.13L15.64 4.7A2 2 0 0 1 17.46 6.87L16.83 13.99"/>
      <path d="M15 7.75v4l-3.46-2Z" fill="#d2521e" stroke="none"/>
    </svg>
    收件箱
  </a>
  <div class="yh-top-right">
    <% if (version) { %><span class="yh-ver" id="version">v<%= version %></span><% } %>
    <details class="yh-menu" id="user-menu">
      <summary aria-label="账号菜单"><span class="yh-avatar"><%= initial %></span></summary>
      <nav class="yh-menu-list" aria-label="账号菜单">
        <% if (version) { %><span class="yh-menu-ver">版本 v<%= version %></span><% } %>
        <a href="settings">设置</a>
        <a href="about">关于</a>
        <% if (hosted) { %><a href="logout" id="logout-link">退出</a><% } %>
      </nav>
    </details>
  </div>
</header>
