# 本地开发用；平台上这些都由平台注入，不用配
PORT=3000
DATABASE_URL=mysql://root:password@127.0.0.1:3306/inbox

# 统一登录与平台模型。不配时本地以「本地用户」匿名运行（只在 NODE_ENV 不是 production 时）
YH_CLIENT_ID=
YH_CLIENT_SECRET=
YH_WEB_URL=http://localhost:5185
YH_API_URL=http://localhost:3105
YH_APP_URL=http://localhost:3000

# 「今天」按哪个时区算，默认 Asia/Shanghai
INBOX_TZ=Asia/Shanghai
# 一句话解析等模型的上限（毫秒），超时就按原文录入
INBOX_PARSE_TIMEOUT_MS=8000
# 设为 1 打开定时推送：每日摘要（默认 08:00，每人可在设置里改）和周五 17:00 的周报（每人自己开）
INBOX_DIGEST=0
